# Environment Configuration for CCTV Video Analysis App

# Application Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Server Configuration
HOST=0.0.0.0
PORT=5000

# File Upload Settings
MAX_CONTENT_LENGTH=536870912  # 512MB in bytes
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv

# AI Model Settings
DEVICE=cuda  # or cpu
SAM2_CHECKPOINT_PATH=checkpoints/sam2_hiera_large.pt
SAM2_CONFIG=sam2_hiera_l.yaml
GROUNDING_DINO_CHECKPOINT_PATH=checkpoints/groundingdino_swint_ogc.pth
GROUNDING_DINO_CONFIG=GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py

# Cloud API Settings (optional, for Grounding DINO 1.5/DINO-X)
# DDS_API_TOKEN=your-dds-api-token-here
# USE_CLOUD_API=False

# Processing Settings
FRAME_STEP=1  # Process every N frames (1 = process all frames)
BOX_THRESHOLD=0.35
TEXT_THRESHOLD=0.25
PROMPT_TYPE=mask  # options: mask, box, point

# Video Processing Settings
MAX_VIDEO_LENGTH=300  # seconds
OUTPUT_VIDEO_FPS=30
OUTPUT_VIDEO_CODEC=mp4v

# Database Settings (optional, for result storage)
# DATABASE_URL=sqlite:///cctv_analysis.db

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Settings
SECURE_FILENAME_ENABLED=True
VALIDATE_FILE_TYPE=True